# ========================================
# Server Environment Variables
# ========================================

# Database — Neon PostgreSQL
# Get your connection string from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/quotation_studio?sslmode=require

# JWT — Admin authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# JWT — Client portal authentication
CLIENT_JWT_SECRET=your-client-jwt-secret-change-in-production
CLIENT_JWT_EXPIRES_IN=24h

# Application
PORT=3000
NODE_ENV=development

# CORS — Your Vercel frontend URL (set in production)
CLIENT_URL=https://your-app.vercel.app

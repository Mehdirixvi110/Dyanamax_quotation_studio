# ========================================
# Construction Quotation Studio
# Full Environment Configuration
# ========================================

# ─── Database (Neon) ─────────────────────────────────────────────
# Sign up at https://neon.tech → Create project → Copy connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/quotation_studio?sslmode=require

# ─── JWT (Admin) ─────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ─── JWT (Client Portal) ─────────────────────────────────────────
CLIENT_JWT_SECRET=your-client-jwt-secret-change-in-production
CLIENT_JWT_EXPIRES_IN=24h

# ─── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────
CLIENT_URL=https://your-app.vercel.app

# ─── Client (Vite — build time) ──────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
# Production: VITE_API_URL=https://your-api.onrender.com/api/v1
